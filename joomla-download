#!/usr/bin/env bash

set -euo pipefail
shopt -s lastpipe nullglob dotglob

declare -r app_name="${0##*/}"
declare -r app_version="1.0-dev"
declare -r base_url="https://github.com/joomla/joomla-cms/releases"

main() {
    if [[ "${1:-}" == '--version' ]]; then
        show_version
    fi

    if [[ -z "${1:-}" || "${1:-}" =~ --help|-h ]]; then
        show_help
    fi

    if ! type -P curl &>/dev/null; then
        error "curl is not installed"
    fi

    if ! type -P tar &>/dev/null; then
        error "tar is not installed"
    fi

    declare -r path="${1}"
    if [[ ! -d "${path}" ]]; then
        error "path does not exist: ${path}"
    fi

    declare -r version="$(joomla_find_version "${2:-${JOOMLA_VERSION:-}}")"
    if [[ -z "${version}" ]]; then
        error "can't find any appropriate version"
    fi

    declare -r download_url="$(joomla_download_url "${version}")"

    echo "Trying to download Joomla ${version}"
    echo
    echo "${download_url}"
    echo

    if ! curl -sL -o /dev/null --head --fail "${download_url}"; then
        error "Joomla ${version} is not available"
    fi

    curl -sL "${download_url}" | tar -xzv -C "${path}"
}

show_version() {
    echo "${app_name} ${app_version}"
    exit 0
}

show_help() {
    echo -n "Download and extract a specific version of Joomla!. (c) PopArtDesign, https://popartdesign.ru

Usage: ${app_name} <path> [<version>]

Arguments:
  <path>      The directory where Joomla! will be downloaded and extracted.
  <version>   Optional. The specific version of Joomla! to download.
              If not provided, the latest stable version will be downloaded.
              Supports semantic versioning (e.g., 5.2.1), major.minor (e.g., 4.3),
              or major (e.g., 3).
              Alternatively, the version can be specified via the JOOMLA_VERSION environment variable.

Options:
  -h, --help  Show this help message and exit.

Examples:
  ${app_name} ~/projects/joomla        # Download the latest version
  ${app_name} ~/projects/joomla 5.2.1  # Download precise version
  ${app_name} ~/projects/joomla 4.3    # Download the latest 4.3.x version (e.g. 4.3.4)
  ${app_name} ~/projects/joomla 3      # Download the latest 3.x version (e.g. 3.10.12)
  ${app_name} .                        # Use current directory (downloads latest version)
"
    exit 0
}

joomla_find_version() {
    declare -r ver="${1:-}"

    if [[ -z "${ver}" ]]; then
        joomla_latest_version
        return
    fi

    # If it's an exact semantic version (e.g., 5.2.1, 5.0.0-alpha1),
    # assume it's valid and let main() verify download availability.
    if [[ "${ver}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z\.-]+)?$ ]]; then
        echo "${ver}"
        return
    fi

    # If not an exact version, try to find version from joomla_get_versions (scrapes downloads.joomla.org)
    declare major="${ver%%.*}"
    case "${ver}" in
    1.0 | 1.0.*)
        major='10'
        ;;
    1.5 | 1.5.*)
        major='15'
        ;;
    1 | 1.* | 2 | 2.*)
        major='25'
        ;;
    esac

    joomla_get_versions "${major}" | while read v; do
        if [[ "${v}" == "${ver}" ]] || [[ "${v}" == "${ver}."* ]]; then
            echo "${v}"
            return
        fi
    done
}

joomla_latest_version() {
    declare -r url="$(curl -sL -o /dev/null -w %{url_effective} "${base_url}/latest")"
    echo "${url##*/}"
}

joomla_get_versions() {
    curl -sL "https://downloads.joomla.org/cms/joomla${1}" |
        sed -Ene 's/^.*Joomla!\s+([0-9\.]+)\s+release.*$/\1/p' |
        sort --unique --reverse --version-sort
}

joomla_download_url() {
    declare -r ver="${1}"
    declare -r stability="${ver##*-}"

    case "${stability}" in
    alpha*)
        echo "${base_url}/download/${ver}/Joomla_${ver}-Alpha-Full_Package.tar.gz"
        ;;
    beta*)
        echo "${base_url}/download/${ver}/Joomla_${ver}-Beta-Full_Package.tar.gz"
        ;;
    rc*)
        echo "${base_url}/download/${ver}/Joomla_${ver}-Release_Candidate-Full_Package.tar.gz"
        ;;
    *)
        echo "${base_url}/download/${ver}/Joomla_${ver}-Stable-Full_Package.tar.gz"
        ;;
    esac
}

error() {
    echo "${app_name}: ${1}" >&2
    exit 1
}

curl() {
    command curl --user-agent "${app_name} ${app_version}" "$@"
}

main "$@"
